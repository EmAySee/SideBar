<Window x:Class="DesktopToolbar.LauncherEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Launcher"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource FluentFontFamily}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Live Icon Preview -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="52" Height="52"
                    CornerRadius="10"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    Margin="0,0,14,0">
                <Image x:Name="IconPreview"
                       Width="34" Height="34"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitleText"
                           Text="Edit Launcher"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Configure shortcut label, target, arguments, and icon"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Form Card -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel>
                <TextBlock Text="Label" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <TextBox x:Name="LabelTextBox" Style="{StaticResource FluentTextBoxStyle}" Margin="0,0,0,12"/>

                <TextBlock Text="Executable Path, Folder, or Command" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExecutableTextBox" Style="{StaticResource FluentTextBoxStyle}"
                             TextChanged="IconInput_Changed"/>
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource FluentButtonStyle}"
                            Margin="8,0,0,0" Click="BrowseExecutable_Click"/>
                </Grid>

                <TextBlock Text="Arguments (optional)" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <TextBox x:Name="ArgumentsTextBox" Style="{StaticResource FluentTextBoxStyle}" Margin="0,0,0,12"/>

                <TextBlock Text="Custom Icon File (.ico / .png — optional)" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="IconPathTextBox" Style="{StaticResource FluentTextBoxStyle}"
                             TextChanged="IconInput_Changed"/>
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource FluentButtonStyle}"
                            Margin="8,0,0,0" Click="BrowseIcon_Click"/>
                </Grid>

                <TextBlock Text="Built-in System Icon" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="BuiltInIconComboBox"
                              Style="{StaticResource FluentComboBoxStyle}"
                              DisplayMemberPath="Key"
                              SelectedValuePath="Value"
                              SelectionChanged="BuiltInIconComboBox_SelectionChanged"/>
                    <Button Grid.Column="1" Content="Shell32 Picker..." Style="{StaticResource FluentButtonStyle}"
                            Margin="8,0,0,0" Click="ChooseShellIcon_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90"
                    Style="{StaticResource FluentButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Save" IsDefault="True" MinWidth="90"
                    Style="{StaticResource FluentAccentButtonStyle}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

