<Window x:Class="DesktopToolbar.ShortcutManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Shortcuts"
        Width="780" Height="500"
        MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource FluentFontFamily}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Edit Shortcuts" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Add, edit, reorder, or remove pinned toolbar launchers"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ShortcutListBox"
                     Grid.Column="0"
                     Style="{StaticResource FluentListBoxStyle}"
                     SelectionChanged="ShortcutListBox_SelectionChanged"
                     MouseDoubleClick="ShortcutListBox_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding AppIcon}"
                                   Width="28" Height="28"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Executable}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Details & Actions Card -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Selected Preview -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Selected Shortcut" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="8"
                                    Background="{DynamicResource ControlBgBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,12,0">
                                <Image x:Name="SelectedIconImage" Width="28" Height="28"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedLabelText" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SelectedArgumentsText" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="SelectedExecutableText"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Row="2">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="MoveUpButton" Grid.Column="0" Content="Move Up"
                                    Style="{StaticResource FluentButtonStyle}" IsEnabled="False" Click="MoveUpButton_Click"/>
                            <Button x:Name="MoveDownButton" Grid.Column="2" Content="Move Down"
                                    Style="{StaticResource FluentButtonStyle}" IsEnabled="False" Click="MoveDownButton_Click"/>
                        </Grid>

                        <Button Content="Add Shortcut..." Style="{StaticResource FluentButtonStyle}"
                                Margin="0,0,0,8" Click="AddButton_Click"/>
                        <Button x:Name="EditButton" Content="Edit Selected..." Style="{StaticResource FluentButtonStyle}"
                                Margin="0,0,0,8" IsEnabled="False" Click="EditButton_Click"/>
                        <Button x:Name="DeleteButton" Content="Delete Selected" Style="{StaticResource FluentDangerButtonStyle}"
                                IsEnabled="False" Click="DeleteButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="92"
                    Style="{StaticResource FluentButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Save" IsDefault="True" MinWidth="92"
                    Style="{StaticResource FluentAccentButtonStyle}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
