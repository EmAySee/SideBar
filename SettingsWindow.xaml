<Window x:Class="DesktopToolbar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toolbar Settings" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#202020"/>
        <SolidColorBrush x:Key="WindowBorder" Color="#333333"/>
        <SolidColorBrush x:Key="TextColor" Color="#F3F3F3"/>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBg}" 
            BorderBrush="{DynamicResource WindowBorder}" 
            BorderThickness="1" CornerRadius="8" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Toolbar Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" Foreground="{DynamicResource TextColor}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Title Prefix" VerticalAlignment="Center" Margin="0,0,10,12" Foreground="{DynamicResource TextColor}"/>
            <TextBox x:Name="TitleTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Padding="6"/>

            <CheckBox x:Name="ShowTitleCheckBox" Grid.Row="2" Grid.ColumnSpan="2" Content="Show title prefix in toolbar" Margin="0,0,0,12" Foreground="{DynamicResource TextColor}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Display mode" VerticalAlignment="Center" Margin="0,0,10,12" Foreground="{DynamicResource TextColor}"/>
            <ComboBox x:Name="DisplayModeComboBox" Grid.Row="3" Grid.Column="1" SelectedIndex="0" Margin="0,0,0,12" Padding="5">
                <ComboBoxItem Content="Icons and text"/>
                <ComboBoxItem Content="Icons only"/>
            </ComboBox>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Bottom offset" VerticalAlignment="Center" Margin="0,0,10,12" Foreground="{DynamicResource TextColor}"/>
            <TextBox x:Name="BottomOffsetTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" Padding="6"/>

            <CheckBox x:Name="AlwaysOnTopCheckBox" Grid.Row="5" Grid.ColumnSpan="2" Content="Always on top" Margin="0,0,0,10" Foreground="{DynamicResource TextColor}"/>
            <CheckBox x:Name="IsLockedCheckBox" Grid.Row="6" Grid.ColumnSpan="2" Content="Lock toolbar position" Margin="0,0,0,20" Foreground="{DynamicResource TextColor}"/>

            <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" MinWidth="85" Padding="10,6" Margin="0,0,8,0"/>
                <Button Content="Save" IsDefault="True" MinWidth="85" Padding="10,6" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>