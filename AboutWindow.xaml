<Window x:Class="DesktopToolbar.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About SideBar" Width="360" Height="250"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="#202020" BorderBrush="#454545" BorderThickness="1" CornerRadius="10" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="SideBar" FontSize="32" FontWeight="Bold" Foreground="#60CDFF" HorizontalAlignment="Center"/>
                <TextBlock Text="Desktop Toolbar" FontSize="16" Foreground="#F3F3F3" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="#B8B8B8" HorizontalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Row="1" Content="Close" IsCancel="True" MinWidth="85" Padding="10,6" HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</Window>
