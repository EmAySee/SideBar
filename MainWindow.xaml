<Window x:Class="DesktopToolbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopToolbar" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="ToolbarBg" Color="#202020" Opacity="0.96"/>
        <SolidColorBrush x:Key="ToolbarBorder" Color="#454545"/>
        <SolidColorBrush x:Key="ToolbarAccent" Color="#60CDFF"/>
        <SolidColorBrush x:Key="ToolbarText" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="ButtonPressed" Color="#1C1C1C"/>
        <LinearGradientBrush x:Key="ButtonGloss" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#38FFFFFF" Offset="0"/>
            <GradientStop Color="#0AFFFFFF" Offset="0.45"/>
            <GradientStop Color="#00000000" Offset="0.62"/>
            <GradientStop Color="#18000000" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonShine" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#70FFFFFF" Offset="0"/>
            <GradientStop Color="#18FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <TranslateTransform x:Key="ButtonPressedOffset" Y="1"/>
    </Window.Resources>

    <Border Background="{DynamicResource ToolbarBg}" 
            BorderBrush="{DynamicResource ToolbarBorder}" 
            BorderThickness="1" CornerRadius="8" Padding="8,6"
            AllowDrop="True"
            DragOver="Toolbar_DragOver"
            DragLeave="Toolbar_DragLeave"
            Drop="Toolbar_Drop"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <!-- Toolbar Context Menu -->
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="➕ Add New Launcher..." Click="Menu_AddLauncher_Click"/>
                <Separator/>
                <MenuItem Header="Display Mode">
                    <MenuItem Header="Icons and Text" Click="Menu_ModeIconsAndText_Click"/>
                    <MenuItem Header="Icons Only" Click="Menu_ModeIconsOnly_Click"/>
                </MenuItem>
                <MenuItem x:Name="MenuLockToggle" Header="🔒 Lock Toolbar" Click="Menu_ToggleLock_Click"/>
                <MenuItem Header="⚙️ Toolbar Settings..." Click="Menu_EditConfig_Click"/>
                <Separator/>
                <MenuItem Header="🔄 Reload Config" Click="Menu_Reload_Click"/>
                <MenuItem Header="❌ Close Toolbar" Click="Menu_Close_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Drag Handle / App Indicator -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0" Margin="6,0,16,0">
                <TextBlock x:Name="DragHandleIcon" Text="⠿" FontSize="18" Foreground="{DynamicResource ToolbarText}" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="SizeAll"/>
                <TextBlock Text="{Binding ToolbarTitle}" Visibility="{Binding ToolbarTitleVisibility}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ToolbarText}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Dynamic App Buttons Repeater -->
            <ItemsControl x:Name="LauncherItemsControl" Grid.Column="1" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="5,0" Padding="0" Height="44"
                                AllowDrop="True"
                                PreviewMouseLeftButtonDown="LauncherButton_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="LauncherButton_PreviewMouseMove"
                                DragOver="LauncherButton_DragOver"
                                Drop="LauncherButton_Drop"
                                Click="LauncherButton_Click"
                                ToolTip="{Binding Label}"
                                Cursor="Hand">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="✏️ Edit Launcher" Click="ItemMenu_Edit_Click"/>
                                    <MenuItem Header="🗑️ Remove Launcher" Click="ItemMenu_Delete_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Width="44" Background="{DynamicResource ButtonBg}" CornerRadius="8" 
                                            BorderBrush="{DynamicResource ToolbarBorder}" BorderThickness="1"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid>
                                            <Border x:Name="btnGloss" CornerRadius="7" Background="{StaticResource ButtonGloss}"
                                                    BorderBrush="{StaticResource ButtonShine}" BorderThickness="1" IsHitTestVisible="False"/>
                                            <StackPanel x:Name="ButtonContent" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Image Source="{Binding AppIcon}" Width="28" Height="28" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="BtnText" Text="{Binding Label}" Foreground="{DynamicResource ToolbarText}" FontSize="6" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="40" VerticalAlignment="Center" Margin="0,1,0,0"
                                                           Visibility="{Binding DataContext.TextVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.TextVisibility, RelativeSource={RelativeSource AncestorType=Window}}" Value="Visible">
                                            <Setter TargetName="btnBorder" Property="Padding" Value="2,2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.TextVisibility, RelativeSource={RelativeSource AncestorType=Window}}" Value="Collapsed">
                                            <Setter TargetName="btnBorder" Property="Padding" Value="8,8"/>
                                            <Setter TargetName="btnBorder" Property="Width" Value="44"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ButtonHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ButtonPressed}"/>
                                            <Setter TargetName="btnBorder" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="ButtonContent" Property="RenderTransform" Value="{StaticResource ButtonPressedOffset}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.ColumnSpan="3" Height="2" Background="{StaticResource ToolbarAccent}"
                    VerticalAlignment="Bottom" Margin="4,0,4,-8" CornerRadius="1"/>

            <TextBlock x:Name="DropHint" Grid.ColumnSpan="3" Text="Drop apps here to create launchers"
                       Foreground="{StaticResource ToolbarText}" Opacity="0.75" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed" IsHitTestVisible="False"/>


        </Grid>
    </Border>
</Window>