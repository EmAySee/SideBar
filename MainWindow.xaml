<Window x:Class="DesktopToolbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhantomCore SideBar"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource FluentFontFamily}"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">

    <Grid>
        <!-- Main Floating Windows 11 Fluent Dock Surface -->
        <Border x:Name="ToolbarSurface"
                Margin="12,4,12,14"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10,6"
                AllowDrop="True"
                DragOver="Toolbar_DragOver"
                DragLeave="Toolbar_DragLeave"
                Drop="Toolbar_Drop"
                MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColor}"
                                  BlurRadius="18"
                                  ShadowDepth="4"
                                  Direction="270"
                                  Opacity="0.28"/>
            </Border.Effect>

            <!-- Windows 11 Fluent Context Menu -->
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add New Launcher..." Click="Menu_AddLauncher_Click">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Edit Shortcuts..." Click="Menu_EditShortcuts_Click">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE70F;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Display Mode">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="12"/>
                        </MenuItem.Icon>
                        <MenuItem x:Name="MenuModeIconsAndText" Header="Icons and Text" IsCheckable="True" Click="Menu_ModeIconsAndText_Click"/>
                        <MenuItem x:Name="MenuModeIconsOnly" Header="Icons Only" IsCheckable="True" Click="Menu_ModeIconsOnly_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="MenuLockToggle" Header="Lock Toolbar Position" IsCheckable="True" Click="Menu_ToggleLock_Click"/>
                    <MenuItem x:Name="MenuAutoHideToggle" Header="Auto-hide When Snapped to Top" IsCheckable="True" Click="Menu_ToggleAutoHide_Click"/>
                    <MenuItem Header="Toolbar Settings..." Click="Menu_EditConfig_Click">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Reload Config" Click="Menu_Reload_Click">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="About PhantomCore SideBar..." Click="Menu_About_Click">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Exit PhantomCore SideBar" Click="Menu_Close_Click">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Drag Handle & Optional Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0" Margin="2,0,8,0">
                    <TextBlock x:Name="DragHandleIcon"
                               Text="&#xE76F;"
                               FontFamily="{StaticResource FluentIconFontFamily}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Opacity="0.65"
                               VerticalAlignment="Center"
                               ToolTip="Drag to move toolbar (right-click for options)"/>

                    <TextBlock Text="{Binding ToolbarTitle}"
                               Visibility="{Binding ToolbarTitleVisibility}"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,2,0"/>

                    <Border Width="1" Height="22"
                            Background="{DynamicResource SeparatorBrush}"
                            Margin="10,0,2,0"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Dynamic App Launcher Tiles -->
                <ItemsControl x:Name="LauncherItemsControl" Grid.Column="1" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="2,0"
                                    Padding="0"
                                    AllowDrop="True"
                                    PreviewMouseLeftButtonDown="LauncherButton_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="LauncherButton_PreviewMouseMove"
                                    DragOver="LauncherButton_DragOver"
                                    Drop="LauncherButton_Drop"
                                    Click="LauncherButton_Click"
                                    ToolTip="{Binding Label}"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Edit Launcher..." Click="ItemMenu_Edit_Click">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="12"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Remove Launcher" Click="ItemMenu_Delete_Click">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="12"
                                                           Foreground="{DynamicResource DangerBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="TileBorder"
                                                Width="64"
                                                Height="54"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="4,5"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <StackPanel x:Name="TileContent"
                                                            Orientation="Vertical"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center">
                                                    <Image x:Name="TileIcon"
                                                           Source="{Binding AppIcon}"
                                                           Width="24" Height="24"
                                                           HorizontalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock x:Name="TileLabel"
                                                               Text="{Binding Label}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="10.5"
                                                               TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="56"
                                                               Margin="0,3,0,0"
                                                               Visibility="{Binding DataContext.TextVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>

                                                <!-- Windows 11 Fluent Hover Accent Pill -->
                                                <Border x:Name="HoverPill"
                                                        Width="14" Height="2.5"
                                                        CornerRadius="1.25"
                                                        Background="{DynamicResource AccentBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,0,-3"
                                                        Opacity="0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.TextVisibility, RelativeSource={RelativeSource AncestorType=Window}}" Value="Collapsed">
                                                <Setter TargetName="TileBorder" Property="Width" Value="42"/>
                                                <Setter TargetName="TileBorder" Property="Height" Value="42"/>
                                                <Setter TargetName="TileBorder" Property="Padding" Value="4"/>
                                                <Setter TargetName="TileIcon" Property="Width" Value="26"/>
                                                <Setter TargetName="TileIcon" Property="Height" Value="26"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                                                <Setter TargetName="HoverPill" Property="Opacity" Value="1"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
                                                <Setter TargetName="TileContent" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" CenterX="18" CenterY="18"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Drag-and-drop Overlay Hint -->
                <Border x:Name="DropHint"
                        Grid.ColumnSpan="2"
                        Background="{DynamicResource DropHighlightBgBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock Text="Drop apps or folders to pin to PhantomCore SideBar"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Sleek Windows 11 Reveal Pill (visible when auto-hidden at top edge) -->
        <Border x:Name="RevealTab"
                Width="52" Height="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,2"
                Background="{DynamicResource RevealPillBrush}"
                CornerRadius="3"
                Visibility="Collapsed"
                Panel.ZIndex="1"/>
    </Grid>
</Window>