<Window x:Class="DesktopToolbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopToolbar" Height="44" Width="750"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="ToolbarBg" Color="#1E1E1E" Opacity="0.85"/>
        <SolidColorBrush x:Key="ToolbarBorder" Color="#333333"/>
        <SolidColorBrush x:Key="ToolbarText" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#3C3C3C"/>
    </Window.Resources>

    <Border Background="{StaticResource ToolbarBg}" 
            BorderBrush="{StaticResource ToolbarBorder}" 
            BorderThickness="1" CornerRadius="6" Padding="6,2"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <!-- Toolbar Context Menu -->
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="➕ Add New Launcher..." Click="Menu_AddLauncher_Click"/>
                <Separator/>
                <MenuItem Header="Display Mode">
                    <MenuItem Header="Icons and Text" Click="Menu_ModeIconsAndText_Click"/>
                    <MenuItem Header="Icons Only" Click="Menu_ModeIconsOnly_Click"/>
                </MenuItem>
                <MenuItem x:Name="MenuLockToggle" Header="🔒 Lock Toolbar" Click="Menu_ToggleLock_Click"/>
                <MenuItem Header="⚙️ Open Config Settings" Click="Menu_EditConfig_Click"/>
                <Separator/>
                <MenuItem Header="🔄 Reload Config" Click="Menu_Reload_Click"/>
                <MenuItem Header="❌ Close Toolbar" Click="Menu_Close_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Drag Handle / App Indicator -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0" Margin="4,0,10,0">
                <TextBlock x:Name="DragHandleIcon" Text="⠿" FontSize="14" Foreground="{StaticResource ToolbarText}" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="SizeAll"/>
                <TextBlock Text="Launchpad" FontWeight="Medium" FontSize="12" Foreground="{StaticResource ToolbarText}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Dynamic App Buttons Repeater with Tooltips & Custom Icons -->
            <ItemsControl x:Name="LauncherItemsControl" Grid.Column="1" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="3,0" Padding="0" 
                                Click="LauncherButton_Click"
                                ToolTip="{Binding Label}"
                                Cursor="Hand">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="✏️ Edit Launcher" Click="ItemMenu_Edit_Click"/>
                                    <MenuItem Header="🗑️ Remove Launcher" Click="ItemMenu_Delete_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="{StaticResource ButtonBg}" CornerRadius="4" Padding="8,4" BorderBrush="{StaticResource ToolbarBorder}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding AppIcon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource ToolbarText}" FontSize="12" VerticalAlignment="Center"
                                                       Visibility="{Binding DataContext.TextVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource ButtonHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Status Indicator -->
            <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,4,0">
                <Ellipse Width="6" Height="6" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="Ready" Foreground="{StaticResource ToolbarText}" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>